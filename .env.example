# MongoDB (Prisma). Use MongoDB Atlas or a replica set; standalone mongod often needs:
#   mongod --replSet rs0
#   then in mongosh: rs.initiate({ _id: "rs0", members: [{ _id: 0, host: "localhost:27017" }] })
# See: https://www.prisma.io/docs/orm/overview/databases/mongodb
# Local: mongodb://127.0.0.1:27017/productqc
# Atlas: mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/DATABASE?retryWrites=true&w=majority
# If the password contains @ # : / ? etc., URL-encode it (e.g. @ → %40)
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/productqc?retryWrites=true&w=majority"

# Auth.js — generate: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# Legacy alias used by some setups; keep in sync with AUTH_SECRET if needed
NEXTAUTH_SECRET=""

# Public app URL for QR payload (optional)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
